/* ── Reset & base ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:        #0d0f11;
  --bg2:       #141619;
  --bg3:       #1a1d21;
  --bg4:       #22262b;
  --border:    rgba(255,255,255,0.07);
  --border2:   rgba(255,255,255,0.12);
  --text:      #e8eaed;
  --text2:     #8a9099;
  --text3:     #555d66;
  --green:     #00c896;
  --green-bg:  rgba(0,200,150,0.1);
  --red:       #ff4f5e;
  --red-bg:    rgba(255,79,94,0.1);
  --blue:      #3b9eff;
  --blue-bg:   rgba(59,158,255,0.1);
  --purple:    #a78bfa;
  --purple-bg: rgba(167,139,250,0.1);
  --amber:     #f59e0b;
  --amber-bg:  rgba(245,158,11,0.1);
  --font-mono: 'JetBrains Mono', monospace;
  --font-sans: 'Inter', sans-serif;
  --radius:    6px;
  --radius-lg: 10px;
}

html, body { height: 100%; background: var(--bg); color: var(--text); font-family: var(--font-sans); font-size: 14px; line-height: 1.5; }

/* ── Scrollbar ── */
::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--bg4); border-radius: 2px; }

/* ── Layout ── */
.app { display: grid; grid-template-rows: auto auto auto 1fr; min-height: 100vh; }

/* ── Nav ── */
.nav { display: flex; align-items: center; justify-content: space-between; padding: 0 20px; height: 52px; background: var(--bg2); border-bottom: 1px solid var(--border); flex-wrap: wrap; gap: 8px; }
.nav-left { display: flex; align-items: center; gap: 12px; }
.logo { font-family: var(--font-mono); font-size: 15px; font-weight: 600; color: var(--text); letter-spacing: -0.5px; }
.logo span { color: var(--green); }
.mode-tabs { display: flex; background: var(--bg3); border-radius: var(--radius); border: 1px solid var(--border); overflow: hidden; }
.mode-tab { font-size: 12px; font-weight: 500; padding: 5px 16px; border: none; background: transparent; cursor: pointer; color: var(--text2); transition: all 0.15s; }
.mode-tab.active-nse { background: var(--blue-bg); color: var(--blue); }
.mode-tab.active-crypto { background: var(--amber-bg); color: var(--amber); }
.nav-right { display: flex; align-items: center; gap: 10px; }
.balance-chip { font-family: var(--font-mono); font-size: 12px; background: var(--bg3); border: 1px solid var(--border); border-radius: 20px; padding: 4px 12px; color: var(--text2); }
.balance-chip strong { color: var(--text); }
.btn-connect { font-size: 11px; font-weight: 500; padding: 4px 12px; border-radius: var(--radius); border: 1px solid var(--border2); background: transparent; color: var(--text2); cursor: pointer; transition: all 0.15s; }
.btn-connect:hover { background: var(--bg3); color: var(--text); }
.dot-live { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--green); margin-right: 5px; animation: pulse 2s infinite; }
.dot-sim { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--amber); margin-right: 5px; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

/* ── Ticker bar ── */
.ticker-bar { display: flex; gap: 0; overflow-x: auto; background: var(--bg2); border-bottom: 1px solid var(--border); padding: 0 20px; }
.ticker-item { display: flex; align-items: center; gap: 10px; padding: 8px 16px 8px 0; margin-right: 16px; border-right: 1px solid var(--border); flex-shrink: 0; }
.ticker-item:last-child { border-right: none; }
.ticker-name { font-size: 11px; font-weight: 600; color: var(--text2); font-family: var(--font-mono); letter-spacing: 0.03em; }
.ticker-price { font-size: 14px; font-weight: 600; color: var(--text); font-family: var(--font-mono); }
.ticker-chg { font-size: 11px; font-family: var(--font-mono); }
.ticker-chg.up { color: var(--green); }
.ticker-chg.dn { color: var(--red); }

/* ── Metrics ── */
.metrics { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: var(--border); border-bottom: 1px solid var(--border); }
.metric { background: var(--bg2); padding: 12px 20px; }
.metric-label { font-size: 10px; font-weight: 500; color: var(--text3); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 4px; }
.metric-val { font-size: 18px; font-weight: 600; font-family: var(--font-mono); color: var(--text); }
.metric-val.pos { color: var(--green); }
.metric-val.neg { color: var(--red); }

/* ── Main layout ── */
.main { display: grid; grid-template-columns: 1fr 300px; flex: 1; min-height: 0; }
.content-panel { padding: 20px; overflow-y: auto; }
.side-panel { background: var(--bg2); border-left: 1px solid var(--border); padding: 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; }

/* ── Content tabs ── */
.content-tabs { display: flex; gap: 2px; margin-bottom: 16px; background: var(--bg3); border-radius: var(--radius); border: 1px solid var(--border); padding: 3px; width: fit-content; }
.ctab { font-size: 12px; font-weight: 500; padding: 5px 14px; border-radius: 4px; cursor: pointer; color: var(--text2); border: none; background: transparent; transition: all 0.15s; }
.ctab.active { background: var(--bg4); color: var(--text); }

/* ── Section title ── */
.sec-title { font-size: 10px; font-weight: 600; color: var(--text3); letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 10px; }

/* ── Table ── */
.tbl { width: 100%; border-collapse: collapse; font-size: 12px; }
.tbl th { text-align: left; font-size: 10px; font-weight: 600; color: var(--text3); letter-spacing: 0.05em; text-transform: uppercase; padding: 6px 8px; border-bottom: 1px solid var(--border); }
.tbl td { padding: 8px 8px; border-bottom: 1px solid var(--border); color: var(--text); vertical-align: middle; }
.tbl tr:last-child td { border-bottom: none; }
.tbl tr:hover td { background: var(--bg3); }
.sym-cell { font-family: var(--font-mono); font-weight: 600; font-size: 12px; color: var(--text); }
.num-cell { font-family: var(--font-mono); }

/* ── Badges ── */
.badge { display: inline-block; font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 4px; font-family: var(--font-mono); letter-spacing: 0.02em; }
.badge-long  { background: var(--green-bg);  color: var(--green); }
.badge-short { background: var(--red-bg);    color: var(--red); }
.badge-eq    { background: var(--blue-bg);   color: var(--blue); }
.badge-opt   { background: var(--purple-bg); color: var(--purple); }
.badge-ce    { background: var(--green-bg);  color: var(--green); }
.badge-pe    { background: var(--red-bg);    color: var(--red); }
.badge-nse   { background: var(--blue-bg);   color: var(--blue); }
.badge-crypto{ background: var(--amber-bg);  color: var(--amber); }

/* ── Form elements ── */
.form-group { display: flex; flex-direction: column; gap: 4px; }
.form-label { font-size: 10px; font-weight: 600; color: var(--text3); text-transform: uppercase; letter-spacing: 0.05em; }
.form-group input, .form-group select {
  font-size: 13px; font-family: var(--font-mono);
  width: 100%; padding: 7px 10px;
  border-radius: var(--radius); border: 1px solid var(--border);
  background: var(--bg3); color: var(--text);
  outline: none; transition: border-color 0.15s;
}
.form-group input:focus, .form-group select:focus { border-color: var(--border2); }
.form-group select option { background: var(--bg3); }

/* ── Side toggle ── */
.side-toggle { display: grid; grid-template-columns: 1fr 1fr; background: var(--bg3); border-radius: var(--radius); border: 1px solid var(--border); overflow: hidden; }
.stab { font-size: 12px; font-weight: 500; padding: 7px; text-align: center; cursor: pointer; border: none; background: transparent; color: var(--text2); transition: all 0.15s; }
.stab.active-buy  { background: var(--green-bg);  color: var(--green); }
.stab.active-sell { background: var(--red-bg);    color: var(--red); }

/* ── Segment buttons ── */
.seg-row { display: flex; gap: 4px; flex-wrap: wrap; }
.seg-btn { font-size: 11px; font-weight: 500; padding: 4px 12px; border-radius: var(--radius); border: 1px solid var(--border); background: transparent; cursor: pointer; color: var(--text2); transition: all 0.15s; font-family: var(--font-sans); }
.seg-btn:hover { border-color: var(--border2); color: var(--text); }
.seg-btn.active { background: var(--bg4); color: var(--text); border-color: var(--border2); }
.seg-btn.active-ce { background: var(--green-bg); color: var(--green); border-color: transparent; }
.seg-btn.active-pe { background: var(--red-bg);   color: var(--red);   border-color: transparent; }

/* ── Buttons ── */
.btn-buy  { width:100%; padding:9px; border-radius:var(--radius); border:none; cursor:pointer; font-size:13px; font-weight:600; background:var(--green); color:#000; transition: opacity 0.15s; }
.btn-sell { width:100%; padding:9px; border-radius:var(--radius); border:none; cursor:pointer; font-size:13px; font-weight:600; background:var(--red);   color:#fff; transition: opacity 0.15s; }
.btn-buy:hover, .btn-sell:hover { opacity: 0.85; }
.btn-reset { font-size:11px; padding:4px 10px; border-radius:var(--radius); border:1px solid var(--border); background:transparent; color:var(--text3); cursor:pointer; }
.btn-reset:hover { color: var(--red); border-color: var(--red-bg); }

/* ── Close button ── */
.xbtn { background:none; border:none; cursor:pointer; color:var(--text3); font-size:16px; padding:2px 6px; border-radius:4px; line-height:1; transition: all 0.15s; }
.xbtn:hover { color: var(--red); background: var(--red-bg); }

/* ── Total line ── */
.total-line { font-size:11px; font-family:var(--font-mono); color:var(--text2); min-height:16px; padding:2px 0; }
.err-msg    { font-size:11px; color:var(--red); min-height:16px; }

/* ── Empty state ── */
.empty { text-align:center; padding:40px 20px; color:var(--text3); }
.empty-icon { font-size:28px; margin-bottom:8px; }
.empty p { font-size:12px; margin-top:4px; }

/* ── Divider ── */
.divider { height:1px; background:var(--border); margin:4px 0; }

/* ── P&L chart ── */
.chart-wrap { position:relative; width:100%; height:280px; background:var(--bg3); border-radius:var(--radius-lg); border:1px solid var(--border); padding:16px; }

/* ── History summary ── */
.hist-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-bottom:16px; }
.hstat { background:var(--bg3); border:1px solid var(--border); border-radius:var(--radius); padding:10px 12px; }
.hstat-label { font-size:10px; color:var(--text3); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:3px; }
.hstat-val { font-size:15px; font-weight:600; font-family:var(--font-mono); color:var(--text); }
.hstat-val.pos { color:var(--green); }
.hstat-val.neg { color:var(--red); }

/* ── Modal overlay ── */
.modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.7); display:flex; align-items:center; justify-content:center; z-index:100; }
.modal { background:var(--bg2); border:1px solid var(--border2); border-radius:var(--radius-lg); padding:24px; width:400px; max-width:95vw; }
.modal-title { font-size:15px; font-weight:600; color:var(--text); margin-bottom:16px; display:flex; justify-content:space-between; align-items:center; }
.modal-grid { display:flex; flex-direction:column; gap:10px; }
.modal-hint { font-size:11px; color:var(--text3); line-height:1.6; background:var(--bg3); border-radius:var(--radius); padding:10px 12px; border:1px solid var(--border); margin-bottom:4px; }
.modal-hint a { color:var(--blue); text-decoration:none; }
.modal-actions { display:flex; flex-direction:column; gap:6px; margin-top:4px; }
.btn-primary { width:100%; padding:9px; border-radius:var(--radius); border:none; cursor:pointer; font-size:13px; font-weight:600; background:var(--blue); color:#fff; }
.btn-secondary { width:100%; padding:8px; border-radius:var(--radius); border:1px solid var(--border); background:transparent; cursor:pointer; font-size:12px; color:var(--text2); }

/* ── Responsive ── */
@media (max-width: 768px) {
  .main { grid-template-columns: 1fr; }
  .side-panel { border-left:none; border-top: 1px solid var(--border); }
  .metrics { grid-template-columns: repeat(2,1fr); }
}
@media (max-width: 480px) {
  .metrics { grid-template-columns: 1fr 1fr; }
  .nav { padding: 0 12px; }
  .content-panel { padding: 12px; }
}

/* ── Watchlist grid cards ── */
.wl-card {
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 8px 10px;
  cursor: pointer;
  transition: all 0.15s;
}
.wl-card:hover { background: var(--bg4); border-color: var(--border2); }
.wl-card.wl-active { border-color: var(--blue); background: var(--blue-bg); }
.wl-sym   { font-size: 11px; font-weight: 600; color: var(--text2); font-family: var(--font-mono); letter-spacing: 0.03em; margin-bottom: 3px; }
.wl-price { font-size: 14px; font-weight: 600; color: var(--text); font-family: var(--font-mono); }
.wl-chg   { font-size: 11px; font-family: var(--font-mono); margin-top: 1px; }
.wl-chg.up { color: var(--green); }
.wl-chg.dn { color: var(--red); }

/* ── Larger chart wrap ── */
.chart-wrap {
  position: relative; width: 100%; height: 280px;
  background: var(--bg3); border-radius: var(--radius-lg);
  border: 1px solid var(--border); padding: 16px;
}

/* ── Stock chart tab layout ── */
.stock-header {
  display: flex; align-items: center;
  justify-content: space-between;
  margin-bottom: 12px; flex-wrap: wrap; gap: 8px;
}

/* ── Option chain ── */
